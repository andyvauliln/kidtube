{
  "manifest_version": 3,
  "name": "KidTube Spike",
  "version": "0.0.2",
  "description": "M0 go/no-go probe for Quetta. Not the product.",
  "key": "",
  "update_url": "https://andyvauliln.github.io/kidtube/updates.xml",
  "permissions": ["storage", "alarms", "tabs", "declarativeNetRequest"],
  "host_permissions": ["*://*.youtube.com/*", "https://api.github.com/*", "https://*.github.io/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "content_scripts": [
    { "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["isolated.js"], "run_at": "document_start" },
    { "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["main.js"], "run_at": "document_start", "world": "MAIN" }
  ],
  "declarative_net_request": { "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules.json" }] },
  "web_accessible_resources": [{ "resources": ["frame.html"], "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"] }],
  "options_page": "options.html"
}
