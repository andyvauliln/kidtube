{
  "manifest_version": 3,
  "name": "Custom Apps",
  "version": "0.12.2",
  "description": "Your own apps over YouTube and Instagram: KidTube (a child's video list with time limits) and Instagram (saved posts with voice notes and AI).",
  "key": "",
  "update_url": "https://andyvauliln.github.io/kidtube/updates.xml",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequest",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://api.github.com/*",
    "https://andyvauliln.github.io/*"
  ],
  "background": {
    "service_worker": "core/background/main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "core/ui/watch.js",
        "core/ui/header.js",
        "core/content/shell.js",
        "apps/kidtube/kid/render.js",
        "apps/kidtube/content/youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "core/content/youtube-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "core/ui/watch.js",
        "core/ui/header.js",
        "apps/instagram/content/api.js",
        "apps/instagram/content/app.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "apps/instagram/lib/reader.js",
        "apps/instagram/content/net.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://andyvauliln.github.io/kidtube/*"
      ],
      "js": [
        "core/content/backup.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "apps/kidtube/kid/*",
        "core/pages/check.html"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ]
    }
  ],
  "options_page": "core/pages/options.html",
  "optional_host_permissions": [
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}
