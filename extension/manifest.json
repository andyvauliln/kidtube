{
  "manifest_version": 3,
  "name": "KidTube",
  "version": "0.9.18",
  "description": "Shows only the videos on your list, with time limits.",
  "key": "",
  "update_url": "https://andyvauliln.github.io/kidtube/updates.xml",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://api.github.com/*",
    "https://andyvauliln.github.io/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "ui/header.js",
        "ui/render.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://andyvauliln.github.io/kidtube/*"
      ],
      "js": [
        "content/backup.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ]
    }
  ],
  "options_page": "options/options.html",
  "optional_host_permissions": [
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}
