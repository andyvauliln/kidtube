{
  "name": "kidtube",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate": "node tools/validate.mjs",
    "orion:check": "node build/orion-check.mjs",
    "orion:build": "node build/build-orion.mjs",
    "release:quetta": "node build/pack.mjs extension --key ~/kidtube-key.pem",
    "ship": "node build/ship.mjs",
    "ship:verify": "node build/ship.mjs verify",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0"
  }
}
