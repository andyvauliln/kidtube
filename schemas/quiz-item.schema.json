{
  "$id": "quiz-item.schema.json",
  "type": "object",
  "required": [
    "type",
    "prompt",
    "answer"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "text = type it, choice = tap it, audio = the question is a sound file, voice = say it out loud (falls back to typing when there is no microphone)"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "audioUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "accept"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text"
            },
            "accept": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "options",
            "correct"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correct": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "audio"
          }
        }
      },
      "then": {
        "required": [
          "audioUrl"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "text"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "choice"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "voice"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          }
        }
      }
    }
  ]
}
