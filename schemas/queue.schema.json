{
  "$id": "queue.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "videos"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "videos": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "videoId",
          "title",
          "channelId",
          "durationSeconds",
          "addedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "videoId": {
            "$ref": "common.schema.json#/$defs/videoId"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "channelId": {
            "$ref": "common.schema.json#/$defs/channelId"
          },
          "channelTitle": {
            "type": "string",
            "maxLength": 200
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "thumbnailUrl": {
            "type": "string",
            "pattern": "^https://i\\.ytimg\\.com/"
          },
          "addedAt": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "quizIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/quizId"
            }
          },
          "allowRewatch": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "intro": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "audioUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "description": "optional recorded voice; without it the tablet reads text aloud"
              }
            },
            "description": "what the talking friend says before the video"
          },
          "outro": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "audioUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "description": "optional recorded voice; without it the tablet reads text aloud"
              }
            },
            "description": "what the talking friend says after the video: what we learned"
          }
        }
      }
    }
  }
}
