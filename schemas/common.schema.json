{
  "$id": "common.schema.json",
  "$defs": {
    "schemaVersion": { "const": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "channelId": { "type": "string", "pattern": "^UC[A-Za-z0-9_-]{22}$" },
    "quizId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "hhmm": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "day": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
  }
}
