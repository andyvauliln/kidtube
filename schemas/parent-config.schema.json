{
  "$id": "parent-config.schema.json",
  "title": "parent-config.json (overlay on extension/default-config.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "minExtensionVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "timezone": {
      "type": "string",
      "pattern": "^(local|[A-Za-z_]+(/[A-Za-z0-9_+-]+)*)$",
      "description": "\"local\" = the tablet's own time zone"
    },
    "blockShorts": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "blockLive": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "blockOutboundLinks": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "blockAds": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "allowSkip": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "false = no jumping forward in a video and no speed above 1x"
    },
    "allowedSiteDomains": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
      }
    },
    "minVideoDurationSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "maxVideoDurationSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "minSecondsBeforeLeave": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 3600
    },
    "closeAfterSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "queueSize": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 30
    },
    "requiredFirst": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "off",
        "first",
        "mix",
        null
      ],
      "description": "must-watch (⭐) videos: first = the others wait until every ⭐ one is watched, mix = one ⭐ then one free choice, off = only a mark"
    },
    "time": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "days",
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/day"
                }
              },
              "from": {
                "$ref": "common.schema.json#/$defs/hhmm"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/hhmm"
              }
            }
          }
        },
        "maxMinutesPerDay": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        }
      }
    },
    "blockedChannelIds": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/channelId"
      }
    },
    "quiz": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "when": {
          "enum": [
            "afterEachVideo",
            null
          ]
        },
        "maxAttempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "itemsPerVideo": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "defaultIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "common.schema.json#/$defs/quizId"
          }
        },
        "items": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/quizId"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "quiz-item.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "onFail": {
          "enum": [
            "continue",
            "rewatch",
            "stopForToday",
            null
          ],
          "description": "after maxAttempts wrong answers: continue = next video, rewatch = the same video once more (once a day), stopForToday = no more videos until tomorrow or a parent resets today"
        }
      }
    },
    "presenter": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "the talking friend before and after each video",
      "properties": {
        "intro": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "outro": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 30
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https://.+|repo:[A-Za-z0-9_./-]+\\.(svg|png|jpg|jpeg|webp|gif))?$",
          "description": "\"\" = built-in character; https://… = a picture; repo:characters/x.svg = a file in the private data repo (an SVG with an element id=\"mouth\" gets a moving mouth)"
        },
        "avatar": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9-]*$",
          "description": "\"\" = the picture above; a name = the mesh avatar bundled in extension/apps/kidtube/avatars/<name>/ (mesh-avatar-studio), shown instead of the picture where the tablet has WebGL2"
        },
        "voice": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "lang": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "pitch": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 2
            },
            "rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0.5,
              "maximum": 2
            },
            "listen": {
              "type": "object",
              "additionalProperties": false,
              "description": "how the tablet hears his answers",
              "properties": {
                "provider": {
                  "enum": [
                    "cloud",
                    "device",
                    "openrouter"
                  ],
                  "description": "cloud (default) = recorded and sent to the free Gemini models, then the paid OpenRouter ones, with keys stored on the tablet; device = the browser’s speech recognition; openrouter = older name of cloud"
                },
                "freeModels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "maxItems": 6,
                  "description": "Gemini API models (free tier), tried first, in order"
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9._-]+/[A-Za-z0-9._:-]+$"
                  },
                  "maxItems": 6,
                  "description": "OpenRouter models (paid), tried after the free ones, in order"
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 15
                }
              }
            },
            "recorded": {
              "type": "boolean",
              "description": "play recordings made by the helper when there are some (default true)"
            }
          }
        },
        "catchphrase": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60,
          "description": "said at the start of the intro and the end of the outro"
        },
        "catchphraseAudioRef": {
          "type": "string",
          "pattern": "^repo:audio/[A-Za-z0-9_-]+\\.(mp3|wav|ogg)$",
          "description": "a recording in the data repo; the tablet plays it instead of its own voice"
        },
        "phrases": {
          "type": "object",
          "description": "recorded lines around the questions, by language (en, ru…) and kind (praise, retry, hello, rewatch, stop, great, tried)",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "audioRef": {
                    "type": "string",
                    "pattern": "^repo:audio/[A-Za-z0-9_-]+\\.(mp3|wav|ogg)$",
                    "description": "a recording in the data repo; the tablet plays it instead of its own voice"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
